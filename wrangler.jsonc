{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "font-convert-compress",
  "main": "dist/index.js",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build",
    "watch_dir": ["src", "charsets", "scripts"]
  },
  "no_bundle": true,
  "find_additional_modules": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // R2 is optional. Uncomment after creating the bucket to enable the font library.
  // "r2_buckets": [
  //   { "binding": "FONTS", "bucket_name": "font-convert-compress-fonts" }
  // ],
  "durable_objects": {
    "bindings": [{ "name": "FONT_LIBRARY", "class_name": "FontLibrary" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FontLibrary"] }],
  // Use platform defaults; custom limits.cpu_ms requires Workers Paid.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "dev": { "ip": "127.0.0.1", "port": 3000 }
}
